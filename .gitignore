# Run outputs. Covers outputs_initial/ (the frozen reproduction baseline) and any
# outputs_verify*/ tree used for parity checks.
outputs*

# Checkpoints and evaluation artefacts, when --out_dir points somewhere other than outputs/.
pretrained_models/

# Figures written by visualization.py, and the per-run diagnostics/logs main.py
# and clustering_logs.py emit.
figures/
diagnostics/
logs/
wandb/

# Machine-specific dataset link: dataroot/wildlife is an absolute symlink, so it is
# recreated per machine rather than committed. See scripts/README.md.
dataroot/

# Launcher retry/attempt bookkeeping.
scripts/.state/

# Setup log from the initial port; superseded by README.md and Todo.md.
CHANGES_MADE.md

__pycache__/
.vscode/
.idea/

# gallery-selection cache (O4); rebuilt on demand
.cache/

# queue driver logs
outputs_*_queue.log

# Ad-hoc diagnostics and their reports (date coverage, AAS ML/CL constraint counts,
# AAS temporal-drift blindness). Read-only analyses of frozen outputs, not part of
# the pipeline; kept locally so they don't age into stale committed numbers.
investigations/
